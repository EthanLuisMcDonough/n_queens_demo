with "config/n_queens_demo_config.gpr";
project N_Queens_Demo is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & N_Queens_Demo_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("n_queens_demo.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatE", "-fstack-check",
         "-g", "-gnata", "-gnatU", "-O3", "-fPIC", "-gnat2022");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end N_Queens_Demo;
